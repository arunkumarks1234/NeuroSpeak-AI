# ─────────────────────────────────────────────────────────────────────────────
# NeuroSpeak-AI — Git Ignore Rules
# ─────────────────────────────────────────────────────────────────────────────

# ── Virtual environment ───────────────────────────────────────────────────────
venv/
.venv/
env/
.env/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
# .env.example is tracked intentionally

# ── Python bytecode ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ── Distribution / packaging ────────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ── Testing ────────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ── Type checking ───────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Linting ────────────────────────────────────────────────────────────────────
.ruff_cache/

# ── Data / model artefacts ──────────────────────────────────────────────────────
# Keep directory structure but ignore contents
data/*.db
data/*.sqlite
data/*.json
ml_models/*.joblib
ml_models/*.pkl
ml_models/*.pt
ml_models/*.pth
ml_models/*.onnx
ml_models/*.nemo
checkpoints/

# ── Audio files in data directories ─────────────────────────────────────────────
data/**/*.wav
data/**/*.mp3
data/**/*.flac
data/**/*.ogg
data/**/*.m4a

# ── Logs ────────────────────────────────────────────────────────────────────────
logs/*.log
logs/*.log.*

# ── Jupyter Notebooks ────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs and editors ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── HuggingFace / Torch caches ───────────────────────────────────────────────────
.cache/
*.safetensors

# ── Gradio ──────────────────────────────────────────────────────────────────────
gradio_cached_examples/
flagged/

# ── Experiment outputs ────────────────────────────────────────────────────────────
experiments/**/*.json
experiments/**/*.csv
experiments/**/results/

# ── Temp / scratch ────────────────────────────────────────────────────────────────
tmp/
temp/
scratch/
