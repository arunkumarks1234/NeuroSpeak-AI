# ─────────────────────────────────────────────────────────────────────────────
# NeuroSpeak-AI  —  Environment Configuration Template
# Copy this file to .env and fill in your values.
# .env is git-ignored and NEVER committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compute ───────────────────────────────────────────────────────────────────
# Device to use for Whisper + Wav2Vec2 inference.
# Options: "auto" (recommended), "cuda", "mps", "cpu"
DEVICE=auto

# ── ASR Provider ──────────────────────────────────────────────────────────────
# Options: "whisper" | "nemo" | "riva"
# "nemo" and "riva" require GPU and their respective packages (requirements-gpu.txt)
ASR_PROVIDER=whisper

# Whisper model size (used when ASR_PROVIDER=whisper)
# Options: tiny, base, small, medium, large-v2, large-v3
WHISPER_MODEL=large-v3

# Whisper compute type — float16 for GPU, int8 for CPU
# Options: float16, int8, float32
WHISPER_COMPUTE_TYPE=auto

# ── Embedding Provider ────────────────────────────────────────────────────────
# Options: "wav2vec2" | "nemo"
EMBEDDING_PROVIDER=wav2vec2

# Wav2Vec2 model (used when EMBEDDING_PROVIDER=wav2vec2)
WAV2VEC2_MODEL=facebook/wav2vec2-base

# ── Ollama (LLM Agents) ───────────────────────────────────────────────────────
# Ollama server URL — change host if using a remote Ollama instance
OLLAMA_HOST=http://localhost:11434

# Model names as they appear in `ollama list`
QWEN_MODEL=qwen2.5
LLAMA_MODEL=llama3.1

# Timeout in seconds for each LLM call (agent will fall back on timeout)
OLLAMA_TIMEOUT=60

# Maximum refinement rounds in the proposer→critic loop (1–3 recommended)
MAX_REFINE_ROUNDS=2

# ── Hallucination Guard ────────────────────────────────────────────────────────
# Maximum expected words per second for dysarthric speech.
# LLM outputs exceeding (audio_duration × this value) will be truncated.
WORDS_PER_SECOND_LIMIT=3.5

# Hallucination guard upper bound — maximum words/sec used by the guard.
MAX_EXPECTED_WPS=3.5

# ── Storage ───────────────────────────────────────────────────────────────────
# Database URL (SQLAlchemy format)
# SQLite (default): sqlite:///./data/sessions.db
# PostgreSQL:       postgresql+psycopg2://user:password@host:5432/neurospeak
DATABASE_URL=sqlite:///./data/sessions.db

# Directory for storing session audio files and embeddings
DATA_DIR=./data

# ── Phonetic Shield ───────────────────────────────────────────────────────────
# Path to the substitution dictionary JSON file
PHONETIC_SHIELD_PATH=./config/phonetic_shield.json

# ── Coaching ──────────────────────────────────────────────────────────────────
# Path to the coaching LLM prompt template
COACHING_PROMPT_PATH=./config/coaching_prompt.txt

# Number of coaching recommendations to generate (3–5 recommended)
COACHING_NUM_RECOMMENDATIONS=4

# ── Gradio UI ─────────────────────────────────────────────────────────────────
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false

# ── Severity ──────────────────────────────────────────────────────────────────
# Classifier backend: "heuristic" (rule-based, always available) or "ml"
# (Logistic Regression trained on Wav2Vec2 embeddings).
# ML backend falls back to heuristic unless a trained model exists.
SEVERITY_CLASSIFIER=heuristic

# Path to serialised ML severity model (created by training/train_severity.py)
SEVERITY_MODEL_PATH=./ml_models/severity_model.joblib

# Composite score thresholds for Mild / Moderate / Severe classification
# Score is normalised to [0.0, 1.0].  mild < MILD_MAX <= moderate < MODERATE_MAX <= severe
SEVERITY_MILD_MAX=0.33
SEVERITY_MODERATE_MAX=0.66

# ── NeMo (experimental) ───────────────────────────────────────────────────────
# Set ASR_PROVIDER=nemo and provide a .nemo checkpoint to use NeMo ASR.
# Requires: nvidia-nemo in requirements-gpu.txt + NVIDIA GPU.
# NEMO_MODEL_PATH=/path/to/model.nemo

# ── Riva (future) ─────────────────────────────────────────────────────────────
# RIVA_URI=localhost:50051
# RIVA_USE_SSL=false
